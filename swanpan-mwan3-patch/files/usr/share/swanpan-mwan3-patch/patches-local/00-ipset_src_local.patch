 				  ${src_ip:+-s} $src_ip \
@@ -978,11 +1071,15 @@
 		current="$($IPT -S)"$'\n'
 
 
-		if [ -n "${current##*-N mwan3_rules*}" ]; then
+		if [ -n "${current##*-N mwan3_rules$'\n'*}" ]; then
 			mwan3_push_update -N "mwan3_rules"
 		fi
+		if [ -n "${current##*-N mwan3_rules_output$'\n'*}" ]; then
+			mwan3_push_update -N "mwan3_rules_output"
+		fi
 
 		mwan3_push_update -F mwan3_rules
+		mwan3_push_update -F mwan3_rules_output
 
 		config_foreach mwan3_set_user_iptables_rule rule "$ipv"
 
@@ -1027,6 +1124,12 @@
 {
 	mwan3_interface_hotplug_shutdown $1
 	mwan3_track_clean $1
+
+	local IPT
+	for IPT in "$IPT4" "$IPT6"; do
+		[ "$IPT" = "$IPT6" ] && [ $NO_IPV6 -ne 0 ] && continue
+		$IPT -D OUTPUT -j mwan3_output_hook >/dev/null 2>&1 || true
+	done
 }
 
