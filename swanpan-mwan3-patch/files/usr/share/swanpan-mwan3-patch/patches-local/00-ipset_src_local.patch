+				mwan3_push_update -A mwan3_output_hook \
+						  -p ipv6-icmp \
+						  -m icmp6 --icmpv6-type 135 \
+						  -j RETURN
+				mwan3_push_update -A mwan3_output_hook \
+						  -p ipv6-icmp \
+						  -m icmp6 --icmpv6-type 136 \
+						  -j RETURN
+				mwan3_push_update -A mwan3_output_hook \
