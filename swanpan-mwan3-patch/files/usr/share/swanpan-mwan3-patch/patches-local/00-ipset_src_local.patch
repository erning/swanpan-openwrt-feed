+					  -j mwan3_ifaces_in
+
+			for chain in custom connected dynamic; do
+				mwan3_push_update -A mwan3_output_hook \
+					-m mark --mark 0x0/$MMX_MASK \
+					-j mwan3_${chain}_${family}
+			done
+
+			mwan3_push_update -A mwan3_output_hook \
