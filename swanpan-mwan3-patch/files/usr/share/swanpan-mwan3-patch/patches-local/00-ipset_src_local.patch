+		fi
 		mwan3_push_update COMMIT
 		mwan3_push_update ""
 
@@ -784,7 +841,8 @@
 
 mwan3_set_user_iptables_rule()
 {
-	local ipset ipset_src family proto policy src_ip src_port src_iface src_dev
+	local ipset ipset_src ipset_src_local output_ipset_src output_policy output_src_dev
+	local family proto policy src_ip src_port src_iface src_dev
 	local sticky dest_ip dest_port use_policy timeout policy
 	local global_logging rule_logging loglevel rule_policy rule ipv
 
@@ -795,6 +853,7 @@
 	config_get timeout "$1" timeout 600
 	config_get ipset "$1" ipset
 	config_get ipset_src "$1" ipset_src
+	config_get_bool ipset_src_local "$1" ipset_src_local 0
 	config_get proto "$1" proto all
 	config_get src_ip "$1" src_ip
 	config_get src_iface "$1" src_iface
@@ -830,7 +889,10 @@
 	[ -z "$dest_ip" ] && unset dest_ip
 	[ -z "$src_ip" ] && unset src_ip
 	[ -z "$ipset" ] && unset ipset
-	[ -z "$ipset_src" ] && unset ipset_src
+	if [ -z "$ipset_src" ]; then
+		unset ipset_src
+		ipset_src_local=0
+	fi
 	[ -z "$src_port" ] && unset src_port
 	[ -z "$dest_port" ] && unset dest_port
 	if [ "$proto" != 'tcp' ] && [ "$proto" != 'udp' ]; then
@@ -855,6 +917,12 @@
 
 	if [ -n "$ipset_src" ]; then
 		ipset_src="-m set --match-set $ipset_src src"
+	fi
+	output_ipset_src="$ipset_src"
+	output_src_dev="$src_dev"
+	if [ "$ipset_src_local" -eq 1 ]; then
+		unset output_ipset_src
+		unset output_src_dev
 	fi
 
 	if [ -z "$use_policy" ]; then
@@ -900,6 +968,36 @@
 		policy="mwan3_rule_$1"
 	fi
+	output_policy="$policy"
+	if [ "$ipset_src_local" -eq 1 ] && [ $rule_policy -eq 1 ] && [ "$sticky" -eq 1 ]; then
+		output_policy="mwan3_policy_$use_policy"
+	fi
+
 	if [ "$global_logging" = "1" ] && [ "$rule_logging" = "1" ]; then
+		mwan3_push_update -A mwan3_rules_output \
+				  -p "$proto" \
