config dldns 'main'
	option domain_id ''
	option domain ''
	option token '@/root/linode.token'
	option ttl '300'

	# DNS preflight uses the system resolver if no nameserver is listed.
	# list nameserver '192.0.2.53'

	# If no interface is listed, dldns discovers all PPPoE interfaces.
	# list interface 'pppoe1'

	# Each record selects IPv4, IPv6, or both address families.
	# list record 'host 4 6'
