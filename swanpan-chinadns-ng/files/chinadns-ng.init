#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # OpenWrt rc.common reads START and STOP.

USE_PROCD=1
START=20
STOP=88

PROG='/usr/sbin/chinadns-ng'
CONFIG='/etc/chinadns-ng.conf'

start_service() {
	[ -x "$PROG" ] || return 1
	[ -s "$CONFIG" ] || return 1
	[ -f /etc/chinadns-ng/chnlist.txt ] || return 1
	[ -f /etc/chinadns-ng/gfwlist.txt ] || return 1

	procd_open_instance
	procd_set_param command "$PROG" --config "$CONFIG"
	procd_set_param respawn 3600 5 5
	procd_set_param file \
		"$CONFIG" \
		/etc/chinadns-ng/chnlist.txt \
		/etc/chinadns-ng/gfwlist.txt \
		/etc/hosts
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
